{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit|NotebookEdit|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 .claude/hooks/sealed-set.py",
            "timeout": 10,
            "statusMessage": "sealed-set check"
          }
        ]
      }
    ]
  }
}
